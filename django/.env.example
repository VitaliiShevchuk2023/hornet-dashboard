# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=hornet.yourdomain.org,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://hornet.yourdomain.org

# Database (Coolify PostGIS resource provides these)
POSTGRES_DB=hornet
POSTGRES_USER=hornet
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (Coolify Redis resource provides this)
REDIS_URL=redis://redis:6379/0
